# Copy to .env (which is gitignored) and fill in your values. Used by
# scripts/sign-darwin-release.sh to sign + notarize the macOS binaries
# after a GitHub release is published.
#
# Note: this file is committed; .env is NOT. Never put real credentials
# in a file without the .example suffix.

# The full "common name" of your Developer ID Application certificate as
# it appears in `security find-identity -v -p codesigning`. Includes the
# Team ID in parentheses.
#
# Example: 'Developer ID Application: Jane Doe (ABCDE12345)'
APPLE_DEV_ID="Developer ID Application: Your Name (TEAMID)"

# Apple ID email used for the developer account.
APPLE_ID="you@example.com"

# An app-specific password generated at https://appleid.apple.com/.
# Format is xxxx-xxxx-xxxx-xxxx (with hyphens).
APPLE_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Your 10-character Apple Team ID (from developer.apple.com → Membership).
APPLE_TEAM_ID="TEAMID"
